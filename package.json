{
  "name": "ccswitch-pulse",
  "version": "0.1.0",
  "description": "A local, read-only model usage dashboard for CC Switch",
  "type": "module",
  "bin": {
    "ccswitch-pulse": "./bin/ccswitch-pulse.js"
  },
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "start": "node ./bin/ccswitch-pulse.js",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "check:syntax": "node ./scripts/check-syntax.mjs",
    "test:coverage": "node --test --experimental-test-coverage",
    "smoke:cli": "node ./scripts/smoke-cli.mjs",
    "benchmark": "node ./scripts/benchmark.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "docs/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "cc-switch",
    "ccswitch",
    "dashboard",
    "sqlite",
    "model-usage"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aa8j/ccswitch-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/aa8j/ccswitch-pulse/issues"
  },
  "homepage": "https://github.com/aa8j/ccswitch-pulse#readme"
}
